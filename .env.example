# Copy this file to .env and fill it in. NEVER share .env or commit it anywhere.

# Your MAIN Hyperliquid wallet address (the one holding the USDC). Public address only.
HL_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000

# Private key of the API wallet you create at https://app.hyperliquid.xyz/API
# (NOT your main wallet key - the script refuses to run with your main key).
# An API wallet can place trades but cannot withdraw funds.
HL_API_WALLET_PRIVATE_KEY=

# mainnet or testnet
HL_NETWORK=mainnet

# USDC to spend per run, and how to split it
DCA_USD=50                 # set your own amount, e.g. 500
CHUNKS=1
CHUNK_DELAY_SEC=0

# Safety limits
MAX_SLIPPAGE_BPS=50        # 50 bps = 0.50% max above best ask
MAX_USD_PER_RUN=1000       # refuses any single run bigger than this (typo guard)
MIN_USDC_RESERVE=0         # always leave at least this much USDC untouched
MAX_SPREAD_BPS=50          # skip the run if bid/ask spread is wider than this
MAX_DEVIATION_BPS=200      # skip if spot ask is >2% away from the BTC perp mid

# Market (leave as is). Mainnet Unit Bitcoin = UBTC, testnet = UNIT.
# BASE_TOKEN=UBTC
# QUOTE_TOKEN=USDC
# SPOT_COIN=@142

# Where fills are logged
# FILLS_CSV=/full/path/to/fills.csv
